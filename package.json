{
    "name": "roolith-css",
    "version": "4.1.0",
    "description": "A simple responsive CSS boilerplate",
    "main": "./src/sass/roolith.scss",
    "scripts": {
        "dev": "vite",
        "dev:host": "vite --host",
        "build": "vite build",
        "preview": "vite preview",
        "css-vars": "node scripts/generate-css-variables.mjs",
        "css-vars:all": "node scripts/generate-css-variables.mjs --all",
        "docs:version": "node scripts/version-docs-assets.mjs",
        "test": "node docs/check-playground-theme.mjs && node scripts/generate-playground-tokens.mjs --check",
        "check:playground": "node docs/check-playground-theme.mjs && node scripts/generate-playground-tokens.mjs --check",
        "tokens": "node scripts/generate-playground-tokens.mjs"
    },
    "repository": "git+https://github.com/im4aLL/roolith-css.git",
    "keywords": [
        "css",
        "framework"
    ],
    "author": "Md Habibullah Al Hadi <me@habibhadi.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/im4aLL/roolith-css/issues"
    },
    "homepage": "https://github.com/im4aLL/roolith-css/blob/master/readme.md",
    "devDependencies": {
        "autoprefixer": "^10.4.21",
        "postcss": "^8.5.6",
        "sass-embedded": "^1.89.2",
        "vite": "^7.0.6",
        "vite-plugin-banner": "^0.8.1",
        "vitepress": "^2.0.0-alpha.21"
    }
}
